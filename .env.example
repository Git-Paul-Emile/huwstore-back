# --- Exécution -------------------------------------------------------------
PORT=8000
# "production" active les cookies Secure/SameSite=None, les journaux JSON et
# masque les traces d'erreur. À laisser vide en développement.
NODE_ENV=development
# debug | info | warn | error
LOG_LEVEL=debug

# --- Base de données -------------------------------------------------------
# Neon (PostgreSQL) — récupérer la chaîne depuis le dashboard Neon.
DATABASE_URL="postgresql://user:password@ep-xxxx.neon.tech/huwstore?sslmode=require"

# --- Authentification ------------------------------------------------------
# Deux secrets DIFFÉRENTS, longs et aléatoires : `openssl rand -base64 48`.
ACCESS_TOKEN_SECRET=change-me-access-secret
REFRESH_TOKEN_SECRET=change-me-refresh-secret
# Mot de passe du compte administrateur créé par `npm run seed` (numéro 709666259).
# Obligatoire en production.
ADMIN_PASSWORD=

# --- Front -----------------------------------------------------------------
# Origines autorisées par le CORS, séparées par des virgules.
CLIENT_URL=http://localhost:5173
# URL publique du site, utilisée dans les liens des e-mails.
SITE_URL=http://localhost:5173

# --- Stockage des images ---------------------------------------------------
# Dashboard Cloudinary (Settings > API Keys). Sans elle, le téléversement
# d'images depuis le back-office est refusé avec un message explicite.
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# --- E-mails transactionnels ----------------------------------------------
# Dashboard Resend (API Keys). Sans elle, les e-mails sont seulement journalisés.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=onboarding@resend.dev
# Destinataire des notifications de commande (la boutique).
SHOP_ADMIN_EMAIL=admi@huwstore.com

# --- Monitoring (Sentry) -------------------------------------------------
# Dashboard Sentry > Project Settings > Client Keys (DSN). Vide = Sentry éteint.
SENTRY_DSN=
# Part des requêtes tracées pour la performance (0 à 1).
SENTRY_TRACES_SAMPLE_RATE=1
