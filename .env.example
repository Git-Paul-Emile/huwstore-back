PORT=8000
# Base Neon (PostgreSQL) — récupérer la chaîne depuis le dashboard Neon.
DATABASE_URL="postgresql://user:password@ep-xxxx.neon.tech/huwstore?sslmode=require"
ACCESS_TOKEN_SECRET=change-me-access-secret
REFRESH_TOKEN_SECRET=change-me-refresh-secret
CLIENT_URL=http://localhost:5173

# Stockage images — dashboard Cloudinary (Settings > API Keys)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Emails transactionnels — dashboard Resend (API Keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=onboarding@resend.dev
