generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  ADMIN
}

enum ProductBadge {
  NOUVEAU
  PROMO
  RUPTURE
}

enum PayStatus {
  PAYE
  EN_ATTENTE
  ECHOUE
}

/// Un seul moyen d'encaissement : a la livraison, en especes.
enum PayMethod {
  COD
}

enum OrderStatus {
  EN_PREPARATION
  EXPEDIEE
  EN_COURS_DE_LIVRAISON
  LIVREE
  RETOURNEE
}

enum DeliveryMode {
  DOMICILE
  POINT_RELAIS
}

enum BannerSlot {
  /// Obsoletes : le hero n'affiche plus de banniere depuis la refonte du bloc
  /// d'accueil, et la pop-up n'a jamais ete affichee. Valeurs conservees pour
  /// les lignes existantes (retirer une valeur d'enum PostgreSQL impose de
  /// recreer le type) ; l'API n'en accepte plus aucune des deux.
  HERO
  BANDEAU_PROMO
  /// Obsolete, voir HERO.
  POPUP
}

enum BannerTarget {
  TOUTES
  MOBILE
  DESKTOP
}

/// Nature de la destination du bouton d'une campagne. PATH : un chemin libre
/// saisi a la main (ctaHref). CATEGORY / PRODUCT : une cible choisie dans le
/// catalogue, dont le serveur deduit l'URL.
enum BannerLinkType {
  PATH
  CATEGORY
  PRODUCT
}

enum PromoType {
  POURCENTAGE
  MONTANT_FIXE
  LIVRAISON_OFFERTE
}

enum StockMoveType {
  ENTREE
  SORTIE
  AJUSTEMENT
  VENTE
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  image     String
  /// Resume affiche sous le nom sur la page d'accueil. Facultatif : une
  /// categorie sans resume retombe sur son nombre de produits.
  description String?
  position  Int       @default(0)
  products  Product[]
  banners   Banner[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([position])
}

/// Fiche produit : l'identite commerciale et les caracteristiques communes a
/// toutes les couleurs. Ce qui varie d'une couleur a l'autre (photos, stock)
/// vit dans ProductVariant - un seul point de verite pour chaque donnee.
model Product {
  id           String        @id
  slug         String        @unique
  name         String
  collection   String
  categoryId   String
  category     Category      @relation(fields: [categoryId], references: [id])
  material     String
  description  String        @db.Text
  care         String        @db.Text
  price        Int
  compareAt    Int?
  badge        ProductBadge?
  videoUrl     String?
  active       Boolean       @default(true)

  // Caracteristiques physiques. Stockees en millimetres et en grammes :
  // des entiers, jamais de flottants, pour eviter toute erreur d'arrondi.
  widthTopMm    Int?
  widthBottomMm Int?
  heightMm      Int?
  depthMm       Int?
  handleDropMm  Int?
  weightGrams   Int?
  closure       String?
  capacity      String?
  features      String[] @default([])

  /// Petit accessoire livre d'office avec le sac (ex. "Livre avec une pochette
  /// assortie"). Facultatif : la plupart des modeles n'en ont pas. Ce n'est pas
  /// un lot a composer par la cliente, juste ce qui est deja dans la boite.
  includedAccessory String?

  variants   ProductVariant[]
  images     ProductImage[]
  orderItems OrderItem[]
  wishlisted WishlistItem[]
  banners    Banner[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([categoryId])
  @@index([active])
}

/// Declinaison couleur d'un produit : c'est l'unite reellement vendue et
/// reellement stockee (le stock et les mouvements pointent ici, pas sur Product).
model ProductVariant {
  id           String  @id @default(cuid())
  productId    String
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku          String  @unique
  colorName    String
  colorSlug    String
  /// Pastille couleur affichee dans l'UI (couleur principale).
  hex          String
  /// Deuxieme couleur pour les modeles bi-matiere (pastille en degrade).
  hexSecondary String?
  position     Int     @default(0)
  active       Boolean @default(true)

  images     ProductImage[]
  stock      Stock?
  stockMoves StockMovement[]
  orderItems OrderItem[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([productId, colorSlug])
  @@index([productId, position])
}

/// Galerie. Une image rattachee a une variante n'apparait que pour cette
/// couleur ; variantId a null = visuel commun (packshot, fiche technique).
model ProductImage {
  id        String          @id @default(cuid())
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  position  Int             @default(0)

  @@index([productId, position])
  @@index([variantId, position])
}

model Stock {
  id        String         @id @default(cuid())
  variantId String         @unique
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  qty       Int            @default(0)
  threshold Int            @default(5)
  updatedAt DateTime       @updatedAt
}

model StockMovement {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  type      StockMoveType
  qty       Int
  reason    String
  author    String
  createdAt DateTime       @default(now())

  @@index([variantId, createdAt])
}

model DeliveryZone {
  id       String  @id @default(cuid())
  city     String
  country  String
  fee      Int
  freeFrom Int
  delay    String
  relay    Boolean @default(false)
  active   Boolean @default(true)

  orders Order[]

  @@unique([city, country])
}

model User {
  id           String   @id @default(cuid())
  name         String
  phone        String   @unique
  email        String?  @unique
  passwordHash String
  role         Role     @default(CLIENT)
  city         String?
  orders       Order[]
  addresses    Address[]
  wishlist     WishlistItem[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Commande. Le montant n'est jamais recu du navigateur : subtotal, shippingFee
/// et discount sont recalcules par le serveur, et total en est la somme. Les
/// garder tous les quatre permet de rejouer le calcul d'une commande ancienne
/// meme si les frais de zone ou le code promo ont change depuis.
///
/// Toute commande est rattachee a un compte : la commande en invite n'est plus
/// ouverte. Le recu et la facture ne sont donc lisibles que par leur acheteuse
/// connectee.
model Order {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Coordonnees figees a l'instant de l'achat : le client peut modifier son
  // carnet d'adresses plus tard, la commande deja passee ne doit pas bouger.
  client      String
  phone       String
  email       String?
  addressLine String
  landmark    String?
  city        String
  country     String

  deliveryMode   DeliveryMode  @default(DOMICILE)
  deliveryZoneId String?
  deliveryZone   DeliveryZone? @relation(fields: [deliveryZoneId], references: [id])

  items OrderItem[]

  subtotal    Int
  shippingFee Int     @default(0)
  discount    Int     @default(0)
  promoCode   String?
  total       Int

  pay      PayStatus   @default(EN_ATTENTE)
  method   PayMethod   @default(COD)
  status   OrderStatus @default(EN_PREPARATION)
  courier  String?
  tracking String?
  note     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([createdAt])
  @@index([deliveryZoneId])
}

/// Carnet d'adresses du client. Une seule adresse peut porter isDefault :
/// la contrainte est tenue par le service, pas par la base (Postgres ne sait
/// pas exprimer "un seul true par userId" sans index partiel).
model Address {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  label     String
  fullName  String
  phone     String
  line      String
  landmark  String?
  city      String
  country   String  @default("Senegal")
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// Favoris rattaches au compte, et non au navigateur : ils suivent la cliente
/// d'un appareil a l'autre. Les visiteurs non connectes gardent une liste locale.
model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId, createdAt])
}

/// Ligne de commande. name, color et price sont fige(e)s a l'instant de l'achat :
/// une hausse de tarif ou un changement de libelle ne doit jamais reecrire
/// l'historique des commandes deja passees.
model OrderItem {
  id        String          @id @default(cuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  name      String
  color     String?
  qty       Int
  price     Int

  @@index([orderId])
  @@index([productId])
}

/// Visuel editorial pilote depuis le back-office : slides du carrousel
/// d'accueil, bandeau promotionnel, pop-up. Rien n'est code en dur cote front.
model Banner {
  id       String       @id @default(cuid())
  title    String
  /// Deuxieme ligne du titre, affichee en italique sous le titre principal.
  subtitle String?
  text     String?
  ctaLabel String?
  /// Nature de la destination du bouton. Le serveur en deduit ctaHref renvoye
  /// a la vitrine : chemin libre, page d'une categorie, ou fiche produit.
  linkType BannerLinkType @default(PATH)
  /// Chemin interne quand linkType vaut PATH, ex. /boutique. Ignore sinon.
  ctaHref  String?
  /// Cible quand linkType vaut CATEGORY. onDelete: SetNull - supprimer la
  /// categorie ne bloque pas, la campagne retombe alors sur /boutique.
  linkCategoryId String?
  linkCategory   Category? @relation(fields: [linkCategoryId], references: [id], onDelete: SetNull)
  /// Cible quand linkType vaut PRODUCT. Meme repli que la categorie.
  linkProductId String?
  linkProduct   Product? @relation(fields: [linkProductId], references: [id], onDelete: SetNull)
  slot     BannerSlot
  target   BannerTarget @default(TOUTES)
  position Int          @default(0)
  start    DateTime
  end      DateTime
  active   Boolean      @default(true)
  image    String

  @@index([slot, active, position])
  @@index([linkCategoryId])
  @@index([linkProductId])
}

/// Parametres de la boutique, edites depuis le back-office et lus par la
/// vitrine (pied de page, widget WhatsApp, e-mails). Une seule ligne, dont
/// l'identifiant est fige : la table ne peut pas porter deux configurations
/// concurrentes.
model Setting {
  id           String   @id @default("shop")
  shopName     String   @default("HUWSTORE")
  phone        String   @default("709666259")
  /// Numero au format international, sans +, pour les liens wa.me.
  whatsapp     String   @default("221709666259")
  email        String?
  city         String   @default("Dakar")
  country      String   @default("Senegal")
  /// Adresse postale imprimee sur la facture. Facultative.
  addressLine  String?
  /// Numero d'identification fiscale, imprime sur la facture quand la boutique
  /// est enregistree. Vide, la facture porte la mention "TVA non applicable".
  ninea        String?
  instagramUrl String?
  facebookUrl  String?
  tiktokUrl    String?
  /// Bandeau libre affiche en haut de la vitrine. Vide = pas de bandeau.
  announcement String?
  updatedAt    DateTime @updatedAt
}

model Promo {
  id      String    @id @default(cuid())
  code    String    @unique
  type    PromoType
  value   Int
  minCart Int       @default(0)
  used    Int       @default(0)
  limit   Int
  end     DateTime
  active  Boolean   @default(true)
}

/// Temoignage client mis en avant sur la page d'accueil ("Les retours de nos
/// clientes"). Contenu editorial saisi et publie depuis le back-office :
/// la boutique choisit ce qu'elle met en avant, rien n'est depose par un visiteur.
model Testimonial {
  id        String   @id @default(cuid())
  author    String
  role      String
  text      String   @db.Text
  avatar    String?
  position  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, position])
}

/// Avis libre depose par une visiteuse sur le site lui-meme (pas sur un
/// produit precis) : suggestion, remarque, satisfaction generale. Lu et traite
/// depuis le back-office, jamais publie automatiquement sur la vitrine.
model Feedback {
  id        String   @id @default(cuid())
  name      String?
  phone     String?
  email     String?
  message   String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read, createdAt])
}
